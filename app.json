{
  "expo": {
    "name": "Corazones",
    "slug": "corazones-mobile",
    "owner": "corazonesargs-team",
    "scheme": "corazones",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.corazones.mobile"
    },
    "android": {
      "package": "com.corazones.mobile",
      "backgroundColor": "#CF3B57",
      "adaptiveIcon": {
        "backgroundColor": "#CE455D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withIosSceneLifecycle",
      "expo-localization",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.486263315165-skaafamiks269iahinlj7ct6b0ktnr6b"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#CF3B57",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "79cfdf08-0b89-4f83-a8a1-618c670e7402"
      }
    }
  }
}
